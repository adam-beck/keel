keel.localhost {
	tls /data/certs/keel.localhost.pem /data/certs/keel.localhost-key.pem

	handle /api/* {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy host.docker.internal:{$UPSTREAM_PORT}
	}

	handle_errors 502 {
		root * /etc/caddy/errors
		rewrite * /502.html
		templates
		file_server
	}
}
